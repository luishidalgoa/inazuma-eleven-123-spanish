{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inazuma123.local/esquemas/resultado.schema.json",
  "title": "Resultado de una operación",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "datos": {
      "type": "object"
    },
    "incidencias": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/incidencia"
      }
    },
    "artefactos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duracion_s": {
      "type": "number"
    },
    "api_version": {
      "type": "string"
    }
  },
  "required": [
    "ok",
    "datos",
    "incidencias",
    "artefactos",
    "duracion_s",
    "api_version"
  ],
  "$defs": {
    "incidencia": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codigo": {
          "type": "string",
          "enum": [
            "TAMANO_PNG",
            "RECT_QNA",
            "GLIFO_NO_SOPORTADO",
            "EXCEDE_PX",
            "EXCEDE_BYTES",
            "BLOQUEO_V20",
            "NF_HUERFANO",
            "PAGINAS_DISTINTAS",
            "CRO_FUERA_DE_RANGO",
            "LAYOUT_MOFLEX",
            "HERRAMIENTA_AUSENTE",
            "NOT_SUPPORTED",
            "CONTENIDO_EN_GIT",
            "GATE_FALLIDO"
          ]
        },
        "severidad": {
          "type": "string",
          "enum": [
            "error",
            "aviso",
            "info"
          ]
        },
        "mensaje": {
          "type": "string"
        },
        "activo_id": {
          "type": "string"
        },
        "ruta": {
          "type": "string"
        },
        "ubicacion": {
          "type": "string"
        },
        "pista": {
          "type": "string"
        }
      },
      "required": [
        "codigo",
        "severidad",
        "mensaje"
      ]
    }
  }
}
