{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inazuma123.local/esquemas/progreso.schema.json",
  "title": "Progreso",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fase": {
      "type": "string"
    },
    "actual": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "mensaje": {
      "type": "string"
    }
  },
  "required": [
    "fase",
    "actual",
    "total",
    "mensaje"
  ],
  "examples": [
    {
      "fase": "extraer",
      "actual": 1,
      "total": 3,
      "mensaje": "vamos"
    }
  ]
}
