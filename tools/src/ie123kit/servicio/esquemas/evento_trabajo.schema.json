{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inazuma123.local/esquemas/evento_trabajo.schema.json",
  "title": "Línea de un JSONL de trabajo",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "trabajo": {
      "type": "string"
    },
    "ts": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "estado",
        "progreso",
        "incidencia",
        "resultado"
      ]
    },
    "datos": {
      "type": "object"
    }
  },
  "required": [
    "trabajo",
    "ts",
    "tipo",
    "datos"
  ],
  "examples": [
    {
      "trabajo": "t-1",
      "ts": "2026-09-16T10:00:00Z",
      "tipo": "progreso",
      "datos": {
        "fase": "extraer",
        "actual": 1,
        "total": 3,
        "mensaje": ""
      }
    }
  ]
}
